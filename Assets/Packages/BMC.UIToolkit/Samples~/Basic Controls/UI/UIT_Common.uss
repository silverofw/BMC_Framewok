/* BMC.UIToolkit 通用樣式。
   對應 uGUI 版 BMC.UI 由 prefab 共用的視覺規範，這裡改用 USS class 提供，
   讓套件內建的基礎面板（MsgPanel／Toast）與專案自訂面板有一致外觀。
   命名採 bmc- 前綴，避免與專案自訂樣式衝突。 */

/* ---------- 版面 ---------- */

/* 全螢幕遮罩：置中內容並壓暗背景 */
.bmc-mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

/* 面板容器 */
.bmc-panel-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px;
    background-color: rgb(35, 35, 40);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(70, 70, 80);
    align-items: stretch;
}

/* ---------- 文字 ---------- */

.bmc-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
    flex-shrink: 0;
}

.bmc-text {
    font-size: 15px;
    color: rgb(215, 215, 220);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
    white-space: normal;
}

/* ---------- 按鈕 ---------- */

.bmc-button-row {
    flex-direction: row;
    justify-content: center;
}

.bmc-button {
    min-width: 104px;
    height: 34px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(70, 70, 80);
    color: rgb(240, 240, 245);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.bmc-button:hover {
    background-color: rgb(90, 90, 102);
}

.bmc-button:active {
    background-color: rgb(55, 55, 64);
}

/* 停用狀態：壓暗底色與文字。
   Unity 內建主題本身會降低停用元素的整體不透明度，這裡再明確指定一次，
   避免專案換掉主題後停用狀態看起來與一般狀態無異。 */
.bmc-button:disabled {
    background-color: rgb(48, 48, 56);
    color: rgb(115, 115, 126);
}

.bmc-button--primary {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.bmc-button--primary:hover {
    background-color: rgb(90, 130, 220);
}

.bmc-button--primary:active {
    background-color: rgb(50, 85, 165);
}

.bmc-button--primary:disabled {
    background-color: rgb(48, 62, 100);
    color: rgb(150, 160, 185);
}

/* ---------- Toast ---------- */

/* Toast 外層：不佔用點擊，避免蓋住底下操作。
   位置比照 uGUI 版 BMC.UI 的 Toast.prefab——錨在畫面中心、往上偏移 200。
   作法是讓內容區塊只佔畫面上半部：以 1080 的參考高度計算，
   扣掉 400 的下方留白後內容區高 680，其中心落在距頂端 340 處，
   等同 uGUI 版「中心 +200」的位置。
   偏移刻意不用 translate，那個屬性留給退場動畫使用。 */
.bmc-toast-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-bottom: 400px;
}

.bmc-toast {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    max-width: 70%;
    background-color: rgba(20, 20, 24, 0.92);
    border-radius: 18px;

    /* 起始狀態：縮小且透明，加上 class 後由 transition 播放進場 */
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale, translate;
    transition-duration: 0.25s, 0.25s, 0.4s;
    transition-timing-function: ease-out, ease-out-back, ease-out;
}

/* 進場後的狀態 */
.bmc-toast--shown {
    opacity: 1;
    scale: 1 1;
}

/* 退場：上飄並淡出 */
.bmc-toast--hidden {
    opacity: 0;
    translate: 0 -80px;
}

.bmc-toast__text {
    font-size: 15px;
    color: rgb(245, 245, 250);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- PreviewPanel（元件展示櫃） ---------- */

.bmc-preview-box {
    width: 480px;
    max-height: 78%;
}

/* ScrollView 在 flex 容器中預設會被內容撐開，
   給 flex-shrink 才會在超過 max-height 時真正出現捲軸 */
.bmc-preview-scroll {
    flex-shrink: 1;
}

/* 分區標題：比內文小、偏灰，用來分隔展示區塊 */
.bmc-section-title {
    font-size: 13px;
    color: rgb(145, 145, 158);
    -unity-font-style: bold;
    margin-top: 14px;
    margin-bottom: 6px;
}

/* 輔助說明文字 */
/* flex-shrink 歸零：與可伸縮的列表同層時，這些固定高度的元素
   不該被壓縮或擠出版面 */
.bmc-hint {
    font-size: 13px;
    color: rgb(160, 160, 172);
    -unity-text-align: middle-center;
    margin-top: 8px;
    flex-shrink: 0;
}

.bmc-preview-footer {
    margin-top: 16px;
    flex-shrink: 0;
}


/* ---------- MultiListView ---------- */

/* Unity 內建主題會替 ListView 的每一列畫 hover／選取反白。
   在多欄網格裡那是「一整列」的底色，語意不對也不好看——
   選取狀態應該由儲存格自己表達。這裡把列容器的底色全部清掉。
   選擇器限定在 MultiListView 之下，不影響專案其他的 ListView。 */
MultiListView .unity-collection-view__item {
    background-color: rgba(0, 0, 0, 0);
}

MultiListView .unity-collection-view__item:hover,
MultiListView .unity-collection-view__item:checked,
MultiListView .unity-collection-view__item:focus {
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- MultiListView 展示 ---------- */

/* 盒子高度隨內容變動，讓「可見列數」的增減看得出來；
   但以 max-height 收住，可見列拉高時不會超出畫面。 */
.bmc-listdemo-box {
    width: 560px;
    max-height: 88%;
}

/* 高度由 show-line-count 決定，這裡不指定高度也不 flex-grow。
   min-height 歸零：盒子撞到 max-height 時，列表要能被壓縮而不是把
   下方的控制列與按鈕擠出版面。 */
.bmc-listdemo-list {
    min-height: 0;
    margin-top: 12px;
    margin-bottom: 8px;
}

.bmc-listdemo-cell {
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 52, 62);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);

    /* 按壓縮放比照 UIButton，讓點擊當下就有回饋 */
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.bmc-listdemo-cell:hover {
    background-color: rgb(66, 66, 78);
}

.bmc-listdemo-cell:active {
    background-color: rgb(44, 44, 52);
    scale: 0.94 0.94;
}

/* 選取狀態：由資料索引驅動，捲動離開再回來仍會保持 */
.bmc-listdemo-cell--selected {
    background-color: rgb(70, 110, 200);
    border-color: rgb(150, 180, 255);
}

.bmc-listdemo-cell--selected:hover {
    background-color: rgb(90, 130, 220);
}

.bmc-listdemo-cell__label {
    font-size: 14px;
    color: rgb(230, 230, 238);
    -unity-text-align: middle-center;
}

/* 行列增減控制列 */
.bmc-listdemo-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    flex-shrink: 0;
}

.bmc-listdemo-controls__label {
    font-size: 13px;
    color: rgb(160, 160, 172);
    margin-left: 14px;
    margin-right: 6px;
}

.bmc-listdemo-controls__value {
    font-size: 14px;
    color: rgb(235, 235, 242);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 34px;
}

/* 給 +／- 這種只放單一符號的小按鈕用 */
.bmc-button--tiny {
    min-width: 28px;
    width: 28px;
    height: 28px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    font-size: 16px;
}

/* ---------- 聊天室 ---------- */

.bmc-chat-box {
    width: 520px;
    max-height: 88%;
}

/* 訊息區可伸縮；min-height 歸零，訊息一多才會出現捲動而不是把輸入列擠掉 */
.bmc-chat-messages {
    flex-grow: 1;
    min-height: 120px;
    margin-top: 8px;
    margin-bottom: 10px;
    padding-right: 4px;
}

/* 單則訊息的外層：靠左或靠右由 --self 決定 */
.bmc-chat-line {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 10px;
}

.bmc-chat-line--self {
    align-items: flex-end;
}

.bmc-chat-meta {
    font-size: 11px;
    color: rgb(140, 140, 152);
    margin-bottom: 3px;
    margin-left: 4px;
    margin-right: 4px;
}

.bmc-chat-bubble {
    max-width: 78%;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(58, 58, 68);
    border-radius: 10px;
}

.bmc-chat-line--self .bmc-chat-bubble {
    background-color: rgb(64, 100, 180);
}

.bmc-chat-bubble__text {
    font-size: 14px;
    color: rgb(238, 238, 244);
    white-space: normal;
}

/* 系統訊息：置中、無氣泡 */
.bmc-chat-line--system {
    align-items: center;
}

.bmc-chat-line--system .bmc-chat-bubble {
    background-color: rgba(0, 0, 0, 0);
}

.bmc-chat-line--system .bmc-chat-bubble__text {
    font-size: 12px;
    color: rgb(140, 140, 152);
    -unity-font-style: italic;
}

.bmc-chat-input-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;

    /* 這一列本身不該被內容撐大，超長輸入要往內縮而不是撐破面板 */
    overflow: hidden;
}

.bmc-chat-input {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    height: 34px;

    /* 關鍵：flex 子元素預設不會縮到小於內容寬度。
       少了這行，一長串不換行的文字會把輸入框連同送出鈕一起擠出面板。
       與列表的 min-height: 0 是同一類問題，只是換成水平方向。 */
    min-width: 0;
}

/* TextField 內部還有一層輸入區，同樣要允許收縮並裁掉超出的文字，
   否則外層縮了、內層仍然照內容寬度撐開。 */
.bmc-chat-input .unity-base-text-field__input {
    min-width: 0;
    overflow: hidden;
}

/* 送出鈕維持固定寬度，不跟著輸入框一起被壓扁 */
.bmc-chat-input-row .bmc-button {
    flex-shrink: 0;
}
