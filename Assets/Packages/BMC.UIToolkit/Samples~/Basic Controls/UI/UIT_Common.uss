/* BMC.UIToolkit 通用樣式。
   對應 uGUI 版 BMC.UI 由 prefab 共用的視覺規範，這裡改用 USS class 提供，
   讓套件內建的基礎面板（MsgPanel／Toast）與專案自訂面板有一致外觀。
   命名採 bmc- 前綴，避免與專案自訂樣式衝突。 */

/* ---------- 版面 ---------- */

/* 全螢幕遮罩：置中內容並壓暗背景 */
.bmc-mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

/* 面板容器 */
.bmc-panel-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px;
    background-color: rgb(35, 35, 40);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(70, 70, 80);
    align-items: stretch;
}

/* ---------- 文字 ---------- */

.bmc-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
    flex-shrink: 0;
}

.bmc-text {
    font-size: 15px;
    color: rgb(215, 215, 220);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
    white-space: normal;
}

/* ---------- 按鈕 ---------- */

.bmc-button-row {
    flex-direction: row;
    justify-content: center;
}

.bmc-button {
    min-width: 104px;
    height: 34px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(70, 70, 80);
    color: rgb(240, 240, 245);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.bmc-button:hover {
    background-color: rgb(90, 90, 102);
}

.bmc-button:active {
    background-color: rgb(55, 55, 64);
}

/* 停用狀態：壓暗底色與文字。
   Unity 內建主題本身會降低停用元素的整體不透明度，這裡再明確指定一次，
   避免專案換掉主題後停用狀態看起來與一般狀態無異。 */
.bmc-button:disabled {
    background-color: rgb(48, 48, 56);
    color: rgb(115, 115, 126);
}

.bmc-button--primary {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.bmc-button--primary:hover {
    background-color: rgb(90, 130, 220);
}

.bmc-button--primary:active {
    background-color: rgb(50, 85, 165);
}

.bmc-button--primary:disabled {
    background-color: rgb(48, 62, 100);
    color: rgb(150, 160, 185);
}

/* ---------- Toast ---------- */

/* Toast 外層：不佔用點擊，避免蓋住底下操作。
   位置比照 uGUI 版 BMC.UI 的 Toast.prefab——錨在畫面中心、往上偏移 200。
   作法是讓內容區塊只佔畫面上半部：以 1080 的參考高度計算，
   扣掉 400 的下方留白後內容區高 680，其中心落在距頂端 340 處，
   等同 uGUI 版「中心 +200」的位置。
   偏移刻意不用 translate，那個屬性留給退場動畫使用。 */
.bmc-toast-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-bottom: 400px;
}

.bmc-toast {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    max-width: 70%;
    background-color: rgba(20, 20, 24, 0.92);
    border-radius: 18px;

    /* 起始狀態：縮小且透明，加上 class 後由 transition 播放進場 */
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale, translate;
    transition-duration: 0.25s, 0.25s, 0.4s;
    transition-timing-function: ease-out, ease-out-back, ease-out;
}

/* 進場後的狀態 */
.bmc-toast--shown {
    opacity: 1;
    scale: 1 1;
}

/* 退場：上飄並淡出 */
.bmc-toast--hidden {
    opacity: 0;
    translate: 0 -80px;
}

.bmc-toast__text {
    font-size: 15px;
    color: rgb(245, 245, 250);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Tab 分頁（PreviewPanel 用） ---------- */

.bmc-hidden {
    display: none;
}

.bmc-tab-bar {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.bmc-tab {
    min-width: 96px;
    height: 30px;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 0;
    border-radius: 15px;
    background-color: rgb(52, 52, 62);
    color: rgb(200, 200, 210);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.bmc-tab:hover {
    background-color: rgb(66, 66, 78);
}

.bmc-tab--active {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.bmc-tab--active:hover {
    background-color: rgb(90, 130, 220);
}

/* ---------- 字體特效展示（PreviewPanel「字體特效」分頁） ---------- */

/* 特效預覽文字：字級拉大方便看清楚效果差異。
   各 fx- 類別只疊加顏色／外框／陰影／字距等屬性，切換時彼此互斥（一次只留一個）。 */
.bmc-fx-preview {
    font-size: 34px;
    color: rgb(235, 235, 242);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    margin-top: 12px;
    margin-bottom: 20px;
    white-space: normal;
}

.bmc-fx-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.fx-bold {
    -unity-font-style: bold;
}

/* 外框描邊：深色描邊 + 亮色文字，常見於遊戲標題，任何背景下都清楚可讀 */
.fx-outline {
    -unity-font-style: bold;
    color: rgb(255, 220, 90);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(40, 30, 10);
}

/* 陰影浮凸：文字往右下投影，製造立體感 */
.fx-shadow {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 3px 3px 4px rgba(0, 0, 0, 0.8);
}

/* 霓虹光暈：飽和亮色文字 + 大範圍模糊陰影模擬發光 */
.fx-neon {
    -unity-font-style: bold;
    color: rgb(130, 255, 235);
    text-shadow: 0 0 12px rgb(60, 220, 200);
}

/* 寬字距標題：拉開字距營造質感標題感 */
.fx-spaced {
    -unity-font-style: bold;
    letter-spacing: 8px;
}

.fx-italic {
    -unity-font-style: italic;
    color: rgb(200, 210, 255);
}

/* ---------- PreviewPanel（元件展示櫃） ---------- */

.bmc-preview-box {
    width: 480px;
    max-height: 78%;
}

/* ScrollView 在 flex 容器中預設會被內容撐開，
   給 flex-shrink 才會在超過 max-height 時真正出現捲軸 */
.bmc-preview-scroll {
    flex-shrink: 1;
}

/* 分區標題：比內文小、偏灰，用來分隔展示區塊 */
.bmc-section-title {
    font-size: 13px;
    color: rgb(145, 145, 158);
    -unity-font-style: bold;
    margin-top: 14px;
    margin-bottom: 6px;
}

/* 輔助說明文字 */
/* flex-shrink 歸零：與可伸縮的列表同層時，這些固定高度的元素
   不該被壓縮或擠出版面 */
.bmc-hint {
    font-size: 13px;
    color: rgb(160, 160, 172);
    -unity-text-align: middle-center;
    margin-top: 8px;
    flex-shrink: 0;
}

.bmc-preview-footer {
    margin-top: 16px;
    flex-shrink: 0;
}


/* ---------- MultiListView ---------- */

/* Unity 內建主題會替 ListView 的每一列畫 hover／選取反白。
   在多欄網格裡那是「一整列」的底色，語意不對也不好看——
   選取狀態應該由儲存格自己表達。這裡把列容器的底色全部清掉。
   選擇器限定在 MultiListView 之下，不影響專案其他的 ListView。 */
MultiListView .unity-collection-view__item {
    background-color: rgba(0, 0, 0, 0);
}

MultiListView .unity-collection-view__item:hover,
MultiListView .unity-collection-view__item:checked,
MultiListView .unity-collection-view__item:focus {
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- MultiListView 展示 ---------- */

/* 盒子高度隨內容變動，讓「可見列數」的增減看得出來；
   但以 max-height 收住，可見列拉高時不會超出畫面。 */
.bmc-listdemo-box {
    width: 560px;
    max-height: 88%;
}

/* 高度由 show-line-count 決定，這裡不指定高度也不 flex-grow。
   min-height 歸零：盒子撞到 max-height 時，列表要能被壓縮而不是把
   下方的控制列與按鈕擠出版面。 */
.bmc-listdemo-list {
    min-height: 0;
    margin-top: 12px;
    margin-bottom: 8px;
}

.bmc-listdemo-cell {
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 52, 62);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);

    /* 按壓縮放比照 UIButton，讓點擊當下就有回饋 */
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.bmc-listdemo-cell:hover {
    background-color: rgb(66, 66, 78);
}

.bmc-listdemo-cell:active {
    background-color: rgb(44, 44, 52);
    scale: 0.94 0.94;
}

/* 選取狀態：由資料索引驅動，捲動離開再回來仍會保持 */
.bmc-listdemo-cell--selected {
    background-color: rgb(70, 110, 200);
    border-color: rgb(150, 180, 255);
}

.bmc-listdemo-cell--selected:hover {
    background-color: rgb(90, 130, 220);
}

.bmc-listdemo-cell__label {
    font-size: 14px;
    color: rgb(230, 230, 238);
    -unity-text-align: middle-center;
}

/* 行列增減控制列 */
.bmc-listdemo-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    flex-shrink: 0;
}

.bmc-listdemo-controls__label {
    font-size: 13px;
    color: rgb(160, 160, 172);
    margin-left: 14px;
    margin-right: 6px;
}

.bmc-listdemo-controls__value {
    font-size: 14px;
    color: rgb(235, 235, 242);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 34px;
}

/* 給 +／- 這種只放單一符號的小按鈕用 */
.bmc-button--tiny {
    min-width: 28px;
    width: 28px;
    height: 28px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    font-size: 16px;
}

/* ---------- 聊天室 ---------- */

.bmc-chat-box {
    width: 520px;
    max-height: 88%;
}

/* 訊息區可伸縮；min-height 歸零，訊息一多才會出現捲動而不是把輸入列擠掉 */
.bmc-chat-messages {
    flex-grow: 1;
    min-height: 120px;
    margin-top: 8px;
    margin-bottom: 10px;
    padding-right: 4px;
}

/* 單則訊息的外層：靠左或靠右由 --self 決定 */
.bmc-chat-line {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 10px;
}

.bmc-chat-line--self {
    align-items: flex-end;
}

.bmc-chat-meta {
    font-size: 11px;
    color: rgb(140, 140, 152);
    margin-bottom: 3px;
    margin-left: 4px;
    margin-right: 4px;
}

.bmc-chat-bubble {
    max-width: 78%;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(58, 58, 68);
    border-radius: 10px;
}

.bmc-chat-line--self .bmc-chat-bubble {
    background-color: rgb(64, 100, 180);
}

.bmc-chat-bubble__text {
    font-size: 14px;
    color: rgb(238, 238, 244);
    white-space: normal;
}

/* 系統訊息：置中、無氣泡 */
.bmc-chat-line--system {
    align-items: center;
}

.bmc-chat-line--system .bmc-chat-bubble {
    background-color: rgba(0, 0, 0, 0);
}

.bmc-chat-line--system .bmc-chat-bubble__text {
    font-size: 12px;
    color: rgb(140, 140, 152);
    -unity-font-style: italic;
}

.bmc-chat-input-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;

    /* 這一列本身不該被內容撐大，超長輸入要往內縮而不是撐破面板 */
    overflow: hidden;
}

.bmc-chat-input {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    height: 34px;

    /* 關鍵：flex 子元素預設不會縮到小於內容寬度。
       少了這行，一長串不換行的文字會把輸入框連同送出鈕一起擠出面板。
       與列表的 min-height: 0 是同一類問題，只是換成水平方向。 */
    min-width: 0;
}

/* TextField 內部還有一層輸入區，同樣要允許收縮並裁掉超出的文字，
   否則外層縮了、內層仍然照內容寬度撐開。 */
.bmc-chat-input .unity-base-text-field__input {
    min-width: 0;
    overflow: hidden;
}

/* 送出鈕維持固定寬度，不跟著輸入框一起被壓扁 */
.bmc-chat-input-row .bmc-button {
    flex-shrink: 0;
}

/* ---------- 除錯面板 ---------- */

/* 對齊 uGUI 版 DebugPanel：左直欄分頁、右單欄滿寬按鈕，
   選取狀態用白框而不是藍色底。不走 .bmc-panel-box，避免卡片外框。 */
.bmc-debug-mask {
    background-color: rgb(0, 0, 0);
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 48px;
    padding-top: 72px;
}

.bmc-debug-box {
    width: 720px;
    max-width: 90%;
    max-height: 80%;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.bmc-debug-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.bmc-debug-tab-scroll {
    width: 168px;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
}

.bmc-debug-tab-list {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
}

.bmc-debug-tab {
    width: 100%;
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 2px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(54, 54, 54);
    color: rgb(235, 235, 235);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.bmc-debug-tab:hover {
    background-color: rgb(70, 70, 70);
}

.bmc-debug-tab--active {
    border-color: rgb(255, 255, 255);
}

.bmc-debug-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    margin-left: 20px;
}

.bmc-debug-grid {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
}

/* 單欄滿寬：gridWidth = 1，上下移動一次一顆。 */
.bmc-debug-item {
    width: auto;
    min-width: 0;
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 2px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(54, 54, 54);
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
}

.bmc-debug-item.bmc-joypad-item--selected {
    background-color: rgb(54, 54, 54);
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
}

.bmc-debug-item.bmc-joypad-item--selected:hover {
    background-color: rgb(70, 70, 70);
}

/* ---------- 手把游標 ---------- */

/* JoypadItem 的選取狀態。UI Toolkit 內建的焦點框在部分主題下幾乎看不見，
   而且我們刻意讓 JoypadItem 不可聚焦（避免與內建焦點導覽搶游標），
   所以選取一律由這個 class 表達。 */
.bmc-joypad-item--selected {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(150, 180, 255);
}

.bmc-joypad-item--selected:hover {
    background-color: rgb(90, 130, 220);
}

/* ---------- LoadPanel ---------- */

/* 整片遮罩。起始為全透明，加上 --shown 後由 transition 淡入；
   時間 0.5s 必須與 LoadPanel.ANIMATION_TIME 一致，否則會出現
   「動畫還沒播完就開始跑進度」或「黑畫面多停一下」。 */
.bmc-load-cover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    /* 整體貼底置中：原本是螢幕正中央，改成靠底部對齊 */
    justify-content: flex-end;
    background-color: rgb(13, 15, 20);

    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.bmc-load-cover--shown {
    opacity: 1;
}

.bmc-load-content {
    align-items: center;
    padding-bottom: 8%;
}

/* spinner 外框，單純置中用，不套其他效果 */
.bmc-load-spinner-wrap {
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}

/* 轉圈本體：純透明底的細圓環，只有一邊上色形成高亮弧段，
   由 LoadPanel 每幀疊加 rotate 角度轉動。之前疊了柔光暈 box-shadow
   在 Unity 的算圖下糊成一顆實心球，不好看，這版拿掉只留乾淨的圈。 */
.bmc-load-spinner {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgb(120, 165, 255);
}

.bmc-load-title {
    font-size: 13px;
    color: rgba(230, 233, 242, 0.6);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 22px;
}

/* 長度兩倍：40% → 80%、320px → 640px，並加 max-width 避免超寬螢幕下條子誇張地長 */
.bmc-load-bar-root {
    width: 80%;
    min-width: 640px;
    max-width: 960px;
    align-items: center;
}

/* 進度條底槽：改成較細的膠囊型，視覺上更接近現代讀取條而非粗長條 */
.bmc-load-bar {
    width: 100%;
    height: 8px;
    background-color: rgb(30, 32, 40);
    border-radius: 4px;
    overflow: hidden;
}

/* 實際進度：寬度由 LoadPanel 以百分比逐幀寫入，
   這裡不對 width 設 transition，平滑已經由 MoveTowards 做過了，
   再疊一層補間會讓進度看起來慢半拍。
   background-color／box-shadow 則保留 transition：跑滿時 LoadPanel 會加上
   --complete class，顏色由藍轉綠會有漸變色過渡的效果。 */
.bmc-load-bar__fill {
    width: 0;
    height: 100%;
    background-color: rgb(100, 150, 255);
    border-radius: 4px;
    box-shadow: 0 0 10px 1px rgba(100, 150, 255, 0.55);
    transition-property: background-color, box-shadow;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.bmc-load-bar__fill--complete {
    background-color: rgb(90, 220, 165);
    box-shadow: 0 0 14px 3px rgba(90, 220, 165, 0.6);
}

/* 跟著進度跑的小圖示：改放在跑條「上方」，圓角方型（不是圓點）。
   left 由 LoadPanel 寫百分比，translate 只在水平方向 -50%，
   讓圖示中心對齊該百分比座標，垂直位置則用 top 固定offset 貼在條子正上方。 */
.bmc-load-bar__cursor {
    position: absolute;
    top: -18px;
    left: 0%;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background-color: rgb(255, 255, 255);
    box-shadow: 0 0 8px 2px rgba(100, 150, 255, 0.8);
    translate: -50% 0;
    transition-property: box-shadow;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.bmc-load-bar__cursor--complete {
    box-shadow: 0 0 10px 3px rgba(90, 220, 165, 0.85);
}

.bmc-load-progress {
    font-size: 15px;
    color: rgb(225, 228, 238);
    -unity-font-style: bold;
    margin-top: 14px;
}

/* 讀取進度說明（RecordTip 帶進來的文字），弱化色調不搶進度數字的焦點 */
.bmc-load-tip {
    font-size: 12px;
    color: rgba(210, 213, 224, 0.5);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

/* ---------- UIToggle ---------- */

.bmc-toggle-group {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.bmc-toggle {
    /* 勾選框用 absolute 浮在左側 padding，不跟 Button 自己畫的文字搶 flex 排版 */
    min-width: 104px;
    height: 34px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 32px;
    padding-right: 12px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(70, 70, 80);
    color: rgb(240, 240, 245);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.bmc-toggle:hover {
    background-color: rgb(90, 90, 102);
}

.bmc-toggle:active {
    background-color: rgb(55, 55, 64);
}

.bmc-toggle--on {
    background-color: rgb(70, 110, 200);
    color: rgb(255, 255, 255);
}

.bmc-toggle--on:hover {
    background-color: rgb(90, 130, 220);
}

.bmc-toggle__box {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgb(150, 150, 160);
    border-radius: 3px;
    background-color: rgb(30, 30, 36);
}

.bmc-toggle--on .bmc-toggle__box {
    border-color: rgb(150, 180, 255);
    background-color: rgb(40, 70, 150);
}

.bmc-toggle__mark {
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
