<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:bmc="BMC.UIToolkit" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="UIT_Common.uss" />
    <ui:VisualElement name="mask" class="bmc-mask">
        <ui:VisualElement name="box" class="bmc-panel-box">
            <bmc:UILabel name="title" class="bmc-title" />
            <bmc:UILabel name="info" class="bmc-text" />
            <ui:VisualElement name="button-row" class="bmc-button-row">
                <!-- 必須是 JoypadItem：MsgPanel 靠它做左右選取／A 確認／B 取消。
                     順序與 uGUI 版相同：[0] 取消、[1] 確認，開啟時預設停在取消。 -->
                <bmc:JoypadItem name="cancel-button" text="Cancel" local-key="COMMON_CANCEL" class="bmc-button" />
                <bmc:JoypadItem name="confirm-button" text="OK" local-key="COMMON_OK" class="bmc-button bmc-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
