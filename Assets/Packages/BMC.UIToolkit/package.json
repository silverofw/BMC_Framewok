{
  "name": "com.bmc.uitoolkit",
  "version": "1.2.2",
  "displayName": "BMC UI Toolkit System",
  "description": "BMC 通用介面系統（UI Toolkit 版）。",
  "unity": "6000.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/silverofw/BMC_Framewok.git"
  },
  "dependencies": {
    "com.bmc.core": "1.0.0"
  },
  "samples": [
    {
      "displayName": "Basic Controls",
      "description": "套件內建的通用介面資源（MsgPanel／Toast／LoadPanel 的 UXML、共用樣式、預設主題與基礎元件）。資源位址一律以 UIT_ 為前綴，避免與 uGUI 版 BMC.UI 的同名資源衝突。",
      "path": "Samples~/Basic Controls"
    },
    {
      "displayName": "Basic UI Flow",
      "description": "最基礎的 UI Toolkit 面板流程範例：開啟面板、按鈕點擊、點背景遮罩關閉。",
      "path": "Samples~/Basic UI Flow"
    }
  ],
  "author": {
    "name": "BMC Studio",
    "url": "https://github.com/silverofw"
  },
  "keywords": [
    "bmc",
    "ui",
    "uitoolkit"
  ]
}
