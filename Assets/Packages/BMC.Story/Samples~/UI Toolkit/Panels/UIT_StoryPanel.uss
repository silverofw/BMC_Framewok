.story-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    padding: 24px;
    justify-content: flex-end;
}

.story-panel__info {
    color: rgb(255, 255, 255);
    font-size: 18px;
    margin-bottom: 12px;
}

.story-panel__choices {
    flex-direction: column;
    margin-bottom: 12px;
}

.story-panel__line-panel-button {
    align-self: flex-end;
}
